<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"

    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F2E">

    <!-- TOP TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0D1B4B"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#FFFFFF"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_dashboard"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingEnd="8dp"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:id="@+id/logoutBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:text="@string/logout"
                android:textColor="#FF4444"
                android:textSize="14sp"
                android:paddingEnd="8dp"
                tools:ignore="RtlSymmetry" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- STATS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        tools:ignore="DisableBaselineAlignment">

        <!-- TOTAL ORDERS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#0D1B4B"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/totalOrdersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_0"
                android:textColor="#2979FF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_orders"
                android:textColor="#7A8BAD"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- PENDING ORDERS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#0D1B4B"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/pendingOrdersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/initial_count_zero"
                android:textColor="#FFA500"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pending"
                android:textColor="#7A8BAD"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- TOTAL REVENUE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#0D1B4B">

            <TextView
                android:id="@+id/totalRevenueCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghs_0"
                android:textColor="#00C853"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/revenue"
                android:textColor="#7A8BAD"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#0D1B4B"
        android:padding="8dp">

        <TextView
            android:id="@+id/tabOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#2979FF"
            android:gravity="center"
            android:text="@string/orders"
            android:textColor="#000000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/products"
            android:textColor="#7A8BAD"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- ORDERS / PRODUCTS LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/adminRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:clipToPadding="false" />

    <!--Empty view section-->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_connection_icon"
            android:textSize="60sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/oops_no_connection"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/we_can_t_fetch_your_products_right_now_check_your_internet"
            android:textColor="#7A8BAD"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2979FF"
            android:textColor="#FFFFFF"
            android:minHeight="48dp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text="@string/try_again" />

    </LinearLayout>
    <!--Empty view section ends here-->

    <!-- ADD PRODUCT BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1B4B"
        android:padding="12dp">

        <Button
            android:id="@+id/addProductBtn"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/add_new_product"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="#2979FF" />

    </LinearLayout>

</LinearLayout>
