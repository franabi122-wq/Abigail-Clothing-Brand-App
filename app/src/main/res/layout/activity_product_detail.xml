<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_coal">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/charcoal_card"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/text_white"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Product Detail"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="8dp" />

            <ImageButton
                android:id="@+id/wishlistBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Wishlist"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="@color/champagne_gold" />

            <ImageButton
                android:id="@+id/shareBtn"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_share"
                app:tint="@color/champagne_gold"
                android:contentDescription="Share Product" />
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/productImage"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:background="@color/charcoal_card"
                android:contentDescription="Product Image" />

            <TextView
                android:id="@+id/productName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <TextView
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GHS 0.00"
                android:textColor="@color/champagne_gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/productCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="@color/dark_coal"
                android:textSize="12sp"
                android:background="@color/champagne_gold"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/charcoal_card"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/productDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product description goes here..."
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/decreaseQty"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:backgroundTint="@color/charcoal_card"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/qtyCount"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/increaseQty"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:backgroundTint="@color/charcoal_card"
                    android:padding="0dp" />

            </LinearLayout>

            <!--Reviews tab starts here-->
            <!-- Customer Reviews Section -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Reviews"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="24dp"
                android:paddingBottom="8dp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reviewsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="12dp" />

            <!--Reviews count section-->
            <TextView
                android:id="@+id/reviewCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Reviews (0)"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/writeReviewBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Write a Review"
                android:textStyle="bold"
                android:textColor="@color/dark_coal"
                android:backgroundTint="@color/champagne_gold"
                android:layout_marginBottom="16dp" />
            <!--Reviews tab ends here-->

            <!--Adding Recyclerview here-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/you_might_also_like"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="24sp"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="20dp" />
            <!--ends here-->

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/charcoal_card"
        android:gravity="center">

        <Button
            android:id="@+id/addToCartBtn"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/add_to_cart"
            android:textColor="@color/dark_coal"
            android:textStyle="bold"
            android:backgroundTint="@color/champagne_gold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/buyNowBtn"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/buy_now"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:backgroundTint="@color/dark_coal" />

    </LinearLayout>

</LinearLayout>